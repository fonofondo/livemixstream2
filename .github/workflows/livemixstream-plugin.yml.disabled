#   build-plugin: cmake -B build (LiveMixStream VST3/AU/Standalone) on
#                 ubuntu-latest, macos-latest, windows-latest
#
# The last active copy lived in build.yml before AsaphOps-only CI.
# LiveMixStream sources remain in the repo (CMakeLists.txt, Source/).
