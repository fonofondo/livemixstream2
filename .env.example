# LiveMixStream — example environment variables
# Copy to .env and adjust, then export before starting the server or DAW:
#   cp .env.example .env
#   set -a && source .env && set +a && npm start
#
# Note: Node does not load .env automatically unless you use a loader.
# The plugin reads LIVEMIXSTREAM_SERVER_URL from the process environment when the DAW loads it.

# --- Server (Node) ---
PORT=3001

# Admin UI password (default: admin)
LMS_ADMIN_PASSWORD=admin

# Optional plugin auth token (empty = disabled)
LMS_PLUGIN_TOKEN=

# --- Plugin default server URL ---
# Used on first open if no saved URL in ~/.config/livemixstream/server.url
LIVEMIXSTREAM_SERVER_URL=http://localhost:3001

# --- WebRTC / mediasoup (production) ---
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# --- Simulator CLI (optional) ---
SERVER_URL=http://localhost:3001
